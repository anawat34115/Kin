    <!-- INTERACTIVE SCRIPTS -->
    <script>
        // State variables
        let currentPackage = {
            quantity: 1,
            name: '1 กล่อง (ทดลองทาน 10 วัน)',
            price: 389,
            shipping: 40
        };

        // Handle Package Selection from Radio Buttons in Checkout Form
        function handlePackageSelect(quantity, price, shipping) {
            currentPackage.quantity = quantity;
            currentPackage.price = price;
            currentPackage.shipping = shipping;

            if (quantity === 1) {
                currentPackage.name = '1 กล่อง (ทดลองทาน 10 วัน)';
            } else if (quantity === 2) {
                currentPackage.name = '2 กล่อง (ชุดโตดี 20 วัน)';
            } else {
                currentPackage.name = '3 กล่อง (ชุดบำรุง 1 เดือน)';
            }

            // Update UI Styles for labels
            for (let i = 1; i <= 3; i++) {
                const label = document.getElementById('label-pkg-' + i);
                if (label) {
                    if (i === quantity) {
                        label.classList.add('border-primary', 'bg-surface-container-low');
                        label.classList.remove('border-stone-200', 'bg-white');
                    } else {
                        label.classList.remove('border-primary', 'bg-surface-container-low');
                        label.classList.add('border-stone-200', 'bg-white');
                    }
                }
            }

            // Update Pricing Breakdown Display
            const subtotalEl = document.getElementById('subtotal-display');
            const shippingEl = document.getElementById('shipping-display');
            const totalEl = document.getElementById('total-display');
            const btnTotalEl = document.getElementById('button-total-price');
            const unitPriceEl = document.getElementById('unit-price-display');

            const total = price + shipping;

            if (subtotalEl) subtotalEl.textContent = '฿' + price.toLocaleString();
            if (shippingEl) {
                shippingEl.textContent = shipping === 0 ? 'ฟรี (โปรโมชั่น)' : '฿' + shipping;
                shippingEl.className = shipping === 0 ? 'font-bold text-matcha-leaf' : 'font-semibold text-deep-forest';
            }
            if (totalEl) totalEl.textContent = '฿' + total.toLocaleString();
            if (btnTotalEl) btnTotalEl.textContent = '฿' + total.toLocaleString();
            if (unitPriceEl) unitPriceEl.textContent = '฿' + price.toLocaleString();
        }

        // Bridge from Package Section cards to Checkout form
        function selectPackageFromCards(pkgId) {
            const checkoutSection = document.getElementById('order-form');
            if (checkoutSection) {
                checkoutSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            if (pkgId === 'pkg-1') {
                const radio = document.querySelector('input[name="product_pack"][value="1"]');
                if (radio) {
                    radio.checked = true;
                    handlePackageSelect(1, 389, 40);
                }
            } else if (pkgId === 'pkg-2') {
                const radio = document.querySelector('input[name="product_pack"][value="2"]');
                if (radio) {
                    radio.checked = true;
                    handlePackageSelect(2, 750, 0);
                }
            }
        }

        // Form Submit Handler
        function handleOrderSubmit(e) {
            e.preventDefault();
            const banner = document.getElementById('order-success-banner');
            if (banner) {
                banner.classList.remove('hidden');
                banner.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        // Send Order Data to LINE OA
        function sendOrderToLine() {
            const name = document.getElementById('cust-name').value || 'คุณแม่ผู้สั่งซื้อ';
            const phone = document.getElementById('cust-phone').value || '-';
            const address = document.getElementById('cust-address').value || '-';
            const district = document.getElementById('cust-district').value || '';
            const zip = document.getElementById('cust-zip').value || '';
            const total = currentPackage.price + currentPackage.shipping;

            const text = encodeURIComponent(
                `🛒 คำสั่งซื้อ Kin Balanza:\n` +
                `- แพ็กเกจ: ${currentPackage.name}\n` +
                `- ยอดสุทธิ: ฿${total.toLocaleString()} บาท\n` +
                `- ชื่อผู้รับ: ${name}\n` +
                `- เบอร์โทร: ${phone}\n` +
                `- ที่อยู่จัดส่ง: ${address} ${district} ${zip}\n` +
                `พร้อมแจ้งโอน / เก็บเงินปลายทางค่ะ`
            );

            window.open(`https://line.me/ti/p/@kinbalanza?text=${text}`, '_blank');
        }
    </script>
</body>

</html>
