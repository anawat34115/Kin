    <!-- Tailwind CSS CDN with plugins -->
    <script src="https://cdn.tailwindcss.com?plugins=forms"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "deep-forest": "#173B25",
                        "primary": "#006e19",
                        "primary-container": "#62d662",
                        "primary-fixed": "#87fc82",
                        "primary-fixed-dim": "#6adf69",
                        "matcha-leaf": "#44B844",
                        "butter-cream": "#FBF7F4",
                        "sun-yellow": "#FDE871",
                        "sky-tint": "#B6DDF6",
                        "peach-sorbet": "#F8DFBF",
                        "wild-lavender": "#EAB8E4",
                        "pure-black": "#111111",
                        "surface": "#f5fcee",
                        "background": "#f5fcee",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#eff6e8",
                        "surface-container": "#e9f0e3",
                        "surface-container-high": "#e3eadd",
                        "surface-container-highest": "#dee5d7",
                        "on-surface": "#171d15",
                        "on-surface-variant": "#3e4a3b",
                        "brand-coral": "#f95738",
                        "brand-lime": "#D8F289",
                    },
                    borderRadius: {
                        'xl': '0.75rem',
                        '2xl': '1rem',
                        '3xl': '1.5rem',
                        '4xl': '2rem',
                    },
                    fontFamily: {
                        sans: ['Prompt', 'Plus Jakarta Sans', 'sans-serif'],
                        display: ['Plus Jakarta Sans', 'Prompt', 'sans-serif'],
                    },
                    keyframes: {
                        marquee: {
                            '0%': { transform: 'translateX(0%)' },
                            '100%': { transform: 'translateX(-50%)' },
                        }
                    },
                    animation: {
                        marquee: 'marquee 28s linear infinite',
                    }
                }
            }
        };
    </script>

    <style>
        *, *::before, *::after, html, body {
            font-family: 'Prompt', 'Plus Jakarta Sans', sans-serif !important;
        }

        .material-symbols-outlined {
            font-family: 'Material Symbols Outlined' !important;
            font-weight: normal;
            font-style: normal;
            line-height: 1;
            letter-spacing: normal;
            text-transform: none;
            display: inline-block;
            white-space: nowrap;
            word-wrap: normal;
            direction: ltr;
            -webkit-font-smoothing: antialiased;
        }

        /* Smooth custom styling */
        .glass-nav {
            background: rgba(251, 247, 244, 0.92);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
        }

        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f5fcee;
        }
        ::-webkit-scrollbar-thumb {
            background: #bdcab7;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #44B844;
        }
    </style>
</head>

