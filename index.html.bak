            <div class="absolute top-1/2 -left-20 w-80 h-80 bg-sky-tint/30 rounded-full blur-3xl pointer-events-none"></div>

            <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center relative z-10">
                
