                                </label>
                                <textarea id="cust-address" required rows="2" placeholder="เลขที่ 123/45 หมู่บ้านสุขสันต์ ถนนสุขุมวิท..."
                                          class="w-full px-4 py-2.5 rounded-xl border border-stone-300 text-sm focus:ring-primary focus:border-primary placeholder:text-stone-400"></textarea>
